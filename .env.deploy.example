# ============================================================================
# .env.deploy.example — Variables consumed by stack.yml at deploy time.
#
# Copy to .env.deploy (gitignored!) and fill in. These are NOT the same as
# the runtime secrets — these are substituted into the stack file itself:
#
#   docker stack deploy -c stack.yml --env-file .env.deploy evonexus
#
# Or in Portainer: paste the contents into the "Environment variables"
# section when creating the stack.
# ============================================================================

# Docker Hub account that hosts the images
DOCKERHUB_USERNAME=your-dockerhub-user

# Image tag to deploy (must exist on Docker Hub for both images)
EVO_NEXUS_TAG=latest

# Public hostname that Traefik will route to the dashboard
EVO_NEXUS_HOST=evonexus.your-domain.com.br

# Name of the Traefik cert resolver already configured in your Traefik
# (usually "letsencrypt", "cloudflare", "staging", etc.)
TRAEFIK_CERTRESOLVER=letsencrypt
