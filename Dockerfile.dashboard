# ============================================================================
# Dockerfile.dashboard — EvoNexus Dashboard image (Flask + React + node-pty)
#
# Three-stage build:
#   Stage 1 (frontend-build):   compiles the React UI with Vite.
#   Stage 2 (terminal-build):   compiles the terminal-server's node_modules,
#                               including node-pty (native C++ module).
#   Stage 3 (runtime):          Python 3.12-slim + uv + Node.js + both CLI
#                               binaries, Flask app serving the SPA.
#
# Why three stages: node-pty needs python3 + gcc + g++ + make at install
# time to build its native addon. Keeping those only in stage 2 means
# the runtime image stays lean but still gets a working terminal-server
# via a node_modules copy.
# ============================================================================

# ---- Stage 1: Frontend build ---------------------------------------------
FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json* ./
RUN npm install
COPY dashboard/frontend/ ./
RUN npm run build

# ---- Stage 2: Terminal-server deps (with native build toolchain) ---------
FROM node:22-slim AS terminal-build
RUN apt-get update && apt-get install -y --no-install-recommends \
        python3 make g++ \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /terminal
COPY dashboard/terminal-server/package.json dashboard/terminal-server/package-lock.json* ./
RUN npm install --omit=dev --no-audit --no-fund

# ---- Stage 3: Python runtime ---------------------------------------------
FROM python:3.12-slim AS runtime

# System deps (curl for healthcheck + uv installer + Node.js for the
# terminal-server binary, no build toolchain needed at runtime).
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates gnupg \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Both CLIs — /providers page switches between them at runtime.
RUN npm install -g \
        @anthropic-ai/claude-code \
        @gitlawb/openclaude

# Timezone
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo "${TZ}" > /etc/timezone

WORKDIR /workspace

# Python deps (cached layer)
COPY pyproject.toml uv.lock ./
RUN uv venv .venv && uv sync --no-dev

# Application code
COPY dashboard/       dashboard/
COPY social-auth/     social-auth/
COPY scheduler.py     ./
COPY .claude/         .claude/
COPY memory/          memory/
COPY ADWs/            ADWs/
COPY config/          config/
COPY Makefile         ./
COPY .env.example     ./

# Terminal-server node_modules from stage 2 (already compiled)
COPY --from=terminal-build /terminal/node_modules dashboard/terminal-server/node_modules

# Built frontend from stage 1
COPY --from=frontend-build /frontend/dist dashboard/frontend/dist

# Stash defaults for first-boot bootstrap (entrypoint.sh copies from here)
RUN mkdir -p /workspace/_defaults/config \
    && cp -a /workspace/config/. /workspace/_defaults/config/ 2>/dev/null || true \
    && cp /workspace/.env.example /workspace/_defaults/.env.example 2>/dev/null || true

# Secrets-to-env + bootstrap wrapper
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# OCI metadata
LABEL org.opencontainers.image.title="evo-nexus-dashboard" \
      org.opencontainers.image.description="EvoNexus Dashboard (Flask + React + embedded CLI terminal)" \
      org.opencontainers.image.source="https://github.com/NeritonDias/evo-nexus" \
      org.opencontainers.image.licenses="MIT"

ENV EVONEXUS_PORT=8080
ENV TERMINAL_SERVER_PORT=32352
EXPOSE 8080 32352

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -fsS "http://localhost:${EVONEXUS_PORT}/api/version" || exit 1

# Copy the multi-process supervisor
COPY start-dashboard.sh /usr/local/bin/start-dashboard.sh
RUN chmod +x /usr/local/bin/start-dashboard.sh

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["/usr/local/bin/start-dashboard.sh"]
