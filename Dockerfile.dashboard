# ============================================================================
# Dockerfile.dashboard — EvoNexus Dashboard image (Flask + React)
#
# Two-stage build:
#   Stage 1 (frontend-build): compiles the React UI with Vite/whatever is
#           configured in dashboard/frontend.
#   Stage 2 (runtime):        Python 3.12-slim + uv + baked-in Flask app
#           serving the built SPA on EVONEXUS_PORT (default 8080).
#
# Swarm-ready: uses the same /usr/local/bin/entrypoint.sh wrapper so Docker
# Secrets automatically surface as env vars (ANTHROPIC_API_KEY, Flask secret
# key, etc.).
# ============================================================================

# ---- Stage 1: Frontend build ---------------------------------------------
FROM node:22-alpine AS frontend-build
WORKDIR /frontend
COPY dashboard/frontend/package.json dashboard/frontend/package-lock.json* ./
RUN npm install
COPY dashboard/frontend/ ./
RUN npm run build

# ---- Stage 2: Python runtime ---------------------------------------------
FROM python:3.12-slim AS runtime

# System deps (curl for healthcheck + uv installer + base utils)
RUN apt-get update && apt-get install -y --no-install-recommends \
        curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# uv
RUN curl -LsSf https://astral.sh/uv/install.sh | sh
ENV PATH="/root/.local/bin:${PATH}"

# Timezone
ENV TZ=America/Sao_Paulo
RUN ln -snf /usr/share/zoneinfo/${TZ} /etc/localtime && echo "${TZ}" > /etc/timezone

WORKDIR /workspace

# Python deps (cached layer)
COPY pyproject.toml uv.lock ./
RUN uv venv .venv && uv sync --no-dev

# Backend code + supporting files
COPY dashboard/backend/ dashboard/backend/
COPY social-auth/       social-auth/
COPY scheduler.py       ./
COPY pyproject.toml     ./

# Baked-in .claude/ content (agents, skills, commands, templates) so the
# dashboard can read them without bind mounts in Swarm. Only the writable
# agent-memory dir is mounted as a volume at deploy time.
COPY .claude/           .claude/
COPY memory/            memory/
COPY ADWs/              ADWs/
COPY CLAUDE.template.md ./

# Built frontend from stage 1
COPY --from=frontend-build /frontend/dist dashboard/frontend/dist

# Writable data dir for SQLite
RUN mkdir -p dashboard/data

# Secrets-to-env wrapper
COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod +x /usr/local/bin/entrypoint.sh

# OCI metadata
LABEL org.opencontainers.image.title="evo-nexus-dashboard" \
      org.opencontainers.image.description="EvoNexus Dashboard (Flask + React)" \
      org.opencontainers.image.source="https://github.com/EvolutionAPI/evo-nexus" \
      org.opencontainers.image.licenses="MIT"

ENV EVONEXUS_PORT=8080
EXPOSE 8080

# Healthcheck (same as the original compose)
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS "http://localhost:${EVONEXUS_PORT}/api/version" || exit 1

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["uv", "run", "python", "dashboard/backend/app.py"]
